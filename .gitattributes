# 统一换行符：仓库内一律 LF，检出的工作区按平台转换
* text=auto

# 构建脚本必须保持 LF，否则在 Linux/macOS 上无法执行
gradlew text eol=lf
*.sh text eol=lf

# 二进制文件不做任何转换
*.jar binary
*.apk binary
*.jks binary
*.png binary
*.webp binary

# 运行证据日志（records/run-evidence/）要逐字节原样入库：run.sh --log 在 Git Bash 上是文本模式写出的
# CRLF，若按上面的 text=auto 归一化成 LF，入库的就不是「当时那份日志」了，字节数与 md5 也对不上
records/run-evidence/** -text
# 分支证据日志（records/branch-evidence/）同理：adb.exe 在 Windows 上吐出的 logcat 带 583 个 CR 字节，
# 按 text=auto 归一化后字节数与 md5 都会变，守卫登记的读数当场报红
records/branch-evidence/** -text
