<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景：两个相依的圆。
  取意「陪伴」——一大一小靠在一起，不喧哗，也不分离。
  画布 108dp，图形全部落在中心 72dp 的安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 大圆：主体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,32 a22,22 0 1,0 0,44 a22,22 0 1,0 0,-44 z" />

    <!-- 小圆：靠在大圆右下，半透明，表示「在旁边」而不是「抢位置」 -->
    <path
        android:fillAlpha="0.72"
        android:fillColor="#FFFFFF"
        android:pathData="M74,40 a16,16 0 1,0 0,32 a16,16 0 1,0 0,-32 z" />

</vector>
